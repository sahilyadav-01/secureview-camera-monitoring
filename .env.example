# SecureView Configuration Template

# Server Port Settings
PORT=5000
FRONTEND_PORT=3000
MONITORING_SERVICE_PORT=5001

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL="postgresql://secureview:secureview_pass@localhost:5432/secureview_db?schema=public"
# DATABASE_URL="file:./dev.db"

# JWT Auth Secret Keys
JWT_SECRET="secureview-super-secret-jwt-key-change-in-production-2026"
JWT_REFRESH_SECRET="secureview-super-secret-refresh-key-change-in-production-2026"
JWT_EXPIRES_IN="24h"

# Redis Cache & PubSub
REDIS_URL="redis://localhost:6379"

# Media Streaming & Transcoding Gateway
MEDIA_STREAM_SERVER_URL="http://localhost:8000"

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:3000"
